  4.473268  0.000000  0.000000
  2.236634  4.807401  0.000000
  0.000000  0.000000  28.346456
ATOMIC_POSITIONS {crystal}
  C  -0.003906  0.007813  0.000000
  C  0.337239  0.325520  0.000000
K_POINTS {automatic}
  24 24 1 0 0 0
