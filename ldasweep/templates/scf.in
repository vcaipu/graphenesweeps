&CONTROL
  calculation = 'scf'
  prefix = 'PREFIX'
  outdir = 'OUTDIR' 
  pseudo_dir = './'
  verbosity = 'high'
/
&SYSTEM
  ibrav = 0
  nat = 2
  ntyp = 1
  ecutwfc = 40.0
  nosym = .true.
  noinv = .true.
  occupations = 'smearing'
  smearing = 'mv'
  degauss = 0.02
/
&ELECTRONS
  conv_thr = 1.0D-8
/
&IONS
  ion_dynamics = 'bfgs'
/
ATOMIC_SPECIES
  C  12.011 PSEUDOPOTENTIAL 
CELL_PARAMETERS {bohr}
  A1X  A1Y  A1Z
  A2X  A2Y  A2Z
  A3X  A3Y  A3Z
ATOMIC_POSITIONS {crystal}
  C  C1X  C1Y  C1Z
  C  C2X  C2Y  C2Z
K_POINTS {automatic}
  NRES NRES 1 0 0 0
