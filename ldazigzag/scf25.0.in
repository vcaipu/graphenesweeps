&CONTROL
  calculation = 'scf'
  prefix = 'graphene25.0zoom'
  outdir = './tmp' 
  pseudo_dir = './'
  verbosity = 'high'
/
&SYSTEM
  ibrav = 0
  nat = 2
  ntyp = 1
  ecutwfc = 40.0
  nosym = .true.
  noinv = .true.
  occupations = 'smearing'
  smearing = 'mv'
  degauss = 0.02
/
&ELECTRONS
  conv_thr = 1.0D-8
/
&IONS
  ion_dynamics = 'bfgs'
/
ATOMIC_SPECIES
  C  12.011 C.upf 
