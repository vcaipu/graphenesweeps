&CONTROL
  calculation = 'scf'
  prefix = 'graphene27.0zoom'
  outdir = './tmp' 
  pseudo_dir = './'
  verbosity = 'high'
/
&SYSTEM
  ibrav = 0
  nat = 2
  ntyp = 1
  ecutwfc = 40.0
  nosym = .true.
  noinv = .true.
  occupations = 'smearing'
  smearing = 'mv'
  degauss = 0.02
/
&ELECTRONS
  conv_thr = 1.0D-8
/
&IONS
  ion_dynamics = 'bfgs'
/
ATOMIC_SPECIES
  C  12.011  C.pbe-n-kjpaw_psl.1.0.0.UPF
CELL_PARAMETERS {bohr}
  5.910580  0.000000  0.000000
  2.955290  3.850924  0.000000
  0.000000  0.000000  30.000000
ATOMIC_POSITIONS {crystal}
  C  0.000893  0.164941  0.000000
  C  0.332440  0.501726  0.000000
K_POINTS {automatic}
  24 24 1 0 0 0
